# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# --- LLM Gateway (see src/orchestrator/llm_manager.py, Day 2) ---
GROQ_API_KEY=
CLAUDE_API_KEY=

# Fallback chain model selection — defaults below are current as of Day 2.
# Groq's lineup: verified live against console.groq.com/docs/models (no
# Mixtral/Llama-2 in production anymore, despite CLAUDE.md section 9).
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Optional local fallback — only used if GROQ_API_KEY is unset/fails and
# Ollama is running (`ollama serve`) with this model pulled. If Ollama isn't
# running, this link just fails and the chain falls through to Claude (demo
# mode) or raises. Set to whatever you've actually pulled (`ollama list`).
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Demo-mode-only Claude call — never hit unless DEMO_MODE=true below.
CLAUDE_MODEL=claude-opus-5

# --- Database ---
DATABASE_URL=sqlite:///./test.db

# --- Mode flags ---
DEMO_MODE=false
DEBUG=false

# --- Confidence / quality thresholds (defaults match CLAUDE.md section 11) ---
PHI_CONFIDENCE_THRESHOLD=0.80
CLINICAL_PRIORITY_THRESHOLD=0.70
QA_CONFIDENCE_THRESHOLD=0.85
DE_ID_PRESERVATION_TARGET=0.90

# --- PHI Agent (Day 4) ---
PHI_SPACY_MODEL=en_core_web_sm
PHI_CONTEXT_WINDOW_CHARS=60

# --- Knowledge Agent / UniRAG (Day 6) ---
# UniRAG is a separate, already-built service (D:\projects\UniRag) — run it
# on a non-default port so it doesn't collide with this project's own API,
# which also defaults to 8000: `uvicorn app.main:app --port 8001`.
UNIRAG_BASE_URL=http://localhost:8001
UNIRAG_TIMEOUT_SECONDS=30.0
UNIRAG_SEARCH_OVERFETCH_K=20
QA_TOP_K=5

# --- Storage paths (created automatically on startup if missing) ---
CHROMA_DB_PATH=./data/chroma_db
UPLOADS_PATH=./data/uploads
TEST_DATA_PATH=./data/test_documents
RESULTS_PATH=./data/results
GROUND_TRUTH_PATH=./data/ground_truth
